# PostgreSQL
POSTGRES_USER=clinic
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=clinicdb

# JWT — use a random string of at least 32 characters
JWT_SECRET=your_jwt_secret_at_least_32_chars_here

# Admin account seeded at startup
ADMIN_EMAIL=admin@clinic.ro
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-...

# LLM model (optional — defaults to claude-sonnet-4-6)
# LLM_MODEL_ID=claude-sonnet-4-6
